<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only the first-run setup and later model/pack downloads use it; answering never does (gate 6 checks this). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The header's ONLINE / OFFLINE pill. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:label="@string/app_name"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Engine bench and the eval:device runner, started from adb (am start -n …/team.sopa.boar.bench.BenchActivity). -->
        <activity
            android:name=".bench.BenchActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true" />
    </application>
</manifest>
